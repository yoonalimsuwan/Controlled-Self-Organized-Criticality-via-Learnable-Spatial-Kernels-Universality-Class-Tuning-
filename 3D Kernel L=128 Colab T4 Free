import numpy as np
import cupy as cp
from cupyx.scipy.fft import next_fast_len
import os
import time

# ==============================================================================
# GPU CONFIGURATION
# ==============================================================================

mempool = cp.get_default_memory_pool()
pinned_mempool = cp.get_default_pinned_memory_pool()

np.random.seed(42)
cp.random.seed(42)

os.makedirs("results", exist_ok=True)

# ==============================================================================
# POWER-LAW EXPONENT ESTIMATION
# ==============================================================================

def mle_tau(avalanches, xmin_pct=15):
    """
    Estimate the avalanche exponent tau using
    Maximum Likelihood Estimation (MLE).
    """

    if len(avalanches) == 0:
        return None

    arr = np.array(avalanches, dtype=float)

    arr = arr[arr >= 1]

    if len(arr) < 50:
        return None

    xmin = max(5.0, np.percentile(arr, xmin_pct))

    arr = arr[arr >= xmin]

    if len(arr) < 20:
        return None

    tau = 1.0 + len(arr) / np.sum(np.log(arr / xmin))

    return float(tau)

# ==============================================================================
# CUDA ELEMENTWISE KERNEL
# ==============================================================================

get_topples = cp.ElementwiseKernel(
    'float32 S_in',
    'float32 tp, float32 S_out',
    '''
    if (S_in >= 1.0f) {
        tp = floor(S_in);
        S_out = S_in - tp;
    } else {
        tp = 0.0f;
        S_out = S_in;
    }
    ''',
    'get_topples'
)

# ==============================================================================
# SECTION 252 — EXTREME GPU 3D SIMULATION
# ==============================================================================

def run_section_252_gpu_3d(
    L=128,
    alphas=[1.5, 3.0, 4.0, 5.0]
):

    print("\n" + "=" * 80)
    print(f"SECTION 252 — EXTREME GPU 3D SIMULATION (L={L})")
    print("=" * 80)

    print("3D Abelian Multi-Toppling with FFT Acceleration")
    print("GPU Backend: CuPy + CUDA\n")

    # --------------------------------------------------------------------------
    # SIMULATION PARAMETERS
    # --------------------------------------------------------------------------

    WARMUP = 100000
    STEPS = 50000

    TOTAL_STEPS = WARMUP + STEPS

    sim_results = []

    # --------------------------------------------------------------------------
    # LOOP OVER ALPHA VALUES
    # --------------------------------------------------------------------------

    for alpha in alphas:

        print("\n" + "-" * 80)
        print(f"Starting simulation for alpha = {alpha}")
        print("-" * 80)

        start_time = time.time()

        # ----------------------------------------------------------------------
        # BUILD 3D LONG-RANGE KERNEL
        # ----------------------------------------------------------------------

        z, y, x = np.ogrid[
            -L//2+1:L//2+1,
            -L//2+1:L//2+1,
            -L//2+1:L//2+1
        ]

        r = np.sqrt(x**2 + y**2 + z**2) + 1e-4

        cutoff = L / 4.0

        K_np = (r ** -alpha) * np.exp(-r / cutoff)

        # remove self-interaction
        K_np[L//2-1, L//2-1, L//2-1] = 0.0

        # normalize kernel
        K_np /= K_np.sum()

        # ----------------------------------------------------------------------
        # TRANSFER TO GPU
        # ----------------------------------------------------------------------

        K = cp.array(K_np, dtype=cp.float32)

        # ----------------------------------------------------------------------
        # INITIALIZE FIELD
        # ----------------------------------------------------------------------

        S = cp.random.rand(
            L,
            L,
            L,
            dtype=cp.float32
        ) * 0.8

        # ----------------------------------------------------------------------
        # PRE-GENERATE RANDOM COORDINATES
        # ----------------------------------------------------------------------

        xi_arr = cp.random.randint(
            1,
            L - 1,
            size=TOTAL_STEPS,
            dtype=cp.int32
        )

        yi_arr = cp.random.randint(
            1,
            L - 1,
            size=TOTAL_STEPS,
            dtype=cp.int32
        )

        zi_arr = cp.random.randint(
            1,
            L - 1,
            size=TOTAL_STEPS,
            dtype=cp.int32
        )

        avalanches = []

        # ----------------------------------------------------------------------
        # FFT PRECOMPUTATION
        # ----------------------------------------------------------------------

        target_shape = 2 * L - 1

        nfl = next_fast_len(target_shape)

        fshape = (nfl, nfl, nfl)

        # padded kernel

        K_padded = cp.zeros(
            fshape,
            dtype=cp.float32
        )

        K_padded[:L, :L, :L] = K

        # FFT(kernel)

        K_fft = cp.fft.rfftn(K_padded)

        # ----------------------------------------------------------------------
        # ZERO-COPY TOPPLE BUFFER
        # ----------------------------------------------------------------------

        tp_padded = cp.zeros(
            fshape,
            dtype=cp.float32
        )

        tp_view = tp_padded[:L, :L, :L]

        start_idx = (target_shape - L) // 2
        end_idx = start_idx + L

        # ----------------------------------------------------------------------
        # MAIN SIMULATION LOOP
        # ----------------------------------------------------------------------

        for t in range(TOTAL_STEPS):

            # add energy grain

            S[
                xi_arr[t],
                yi_arr[t],
                zi_arr[t]
            ] += 0.85

            A = 0

            while True:

                # --------------------------------------------------------------
                # PARALLEL MULTI-TOPPLING
                # --------------------------------------------------------------

                get_topples(S, tp_view, S)

                num_topple = int(tp_view.sum())

                if num_topple == 0:
                    break

                A += num_topple

                # --------------------------------------------------------------
                # 3D FFT CONVOLUTION
                # --------------------------------------------------------------

                tp_fft = cp.fft.rfftn(tp_padded)

                spread_padded = cp.fft.irfftn(
                    tp_fft * K_fft,
                    s=fshape
                )

                # crop back to physical volume

                S += spread_padded[
                    start_idx:end_idx,
                    start_idx:end_idx,
                    start_idx:end_idx
                ]

                # --------------------------------------------------------------
                # ABSORBING BOUNDARY CONDITIONS
                # --------------------------------------------------------------

                S[0, :, :] = 0
                S[-1, :, :] = 0

                S[:, 0, :] = 0
                S[:, -1, :] = 0

                S[:, :, 0] = 0
                S[:, :, -1] = 0

            # ------------------------------------------------------------------
            # RECORD AVALANCHES
            # ------------------------------------------------------------------

            if t >= WARMUP and A > 2:
                avalanches.append(A)

            # ------------------------------------------------------------------
            # PROGRESS REPORT
            # ------------------------------------------------------------------

            if t > 0 and t % 5000 == 0:

                elapsed = (
                    time.time() - start_time
                ) / 60

                phase = (
                    "Warmup"
                    if t < WARMUP
                    else "Recording"
                )

                print(
                    f"[{phase}] "
                    f"Step {t}/{TOTAL_STEPS} "
                    f"| Elapsed = {elapsed:.2f} mins"
                )

                mempool.free_all_blocks()

        # ----------------------------------------------------------------------
        # SAVE AVALANCHE DATA
        # ----------------------------------------------------------------------

        save_path = (
            f"results/avalanches_3d_alpha_{alpha}.csv"
        )

        np.savetxt(
            save_path,
            avalanches,
            delimiter=","
        )

        print(f"\nSaved avalanche data to:")
        print(save_path)

        # ----------------------------------------------------------------------
        # ESTIMATE TAU
        # ----------------------------------------------------------------------

        tau = mle_tau(avalanches)

        total_time = (
            time.time() - start_time
        ) / 60

        sim_results.append((alpha, tau))

        print("\nResults:")

        if tau is not None:

            print(f"alpha = {alpha}")
            print(f"tau   = {tau:.5f}")
            print(f"events = {len(avalanches)}")

        else:

            print("Insufficient events for stable tau estimation")

        print(f"runtime = {total_time:.2f} mins")

        # ----------------------------------------------------------------------
        # FREE GPU MEMORY
        # ----------------------------------------------------------------------

        del K
        del S
        del K_fft
        del K_padded
        del tp_padded
        del tp_view

        mempool.free_all_blocks()

    return sim_results

# ==============================================================================
# SECTION 398 — RESULTS SUMMARY
# ==============================================================================

def run_section_398_summary(sim_results):

    print("\n" + "=" * 80)
    print("SECTION 398 — RESULTS SUMMARY")
    print("=" * 80)

    valid_data = [
        (a, t)
        for a, t in sim_results
        if t is not None
    ]

    if len(valid_data) == 0:

        print("No valid data available.")
        return

    for alpha, tau in valid_data:

        print(
            f"alpha = {alpha:<4} "
            f"--> tau = {tau:.5f}"
        )

# ==============================================================================
# MAIN EXECUTION
# ==============================================================================

if __name__ == "__main__":

    results = run_section_252_gpu_3d(
        L=128,
        alphas=[1.5, 3.0, 4.0, 5.0]
    )

    run_section_398_summary(results)

    print("\n3D GPU simulations complete.")
